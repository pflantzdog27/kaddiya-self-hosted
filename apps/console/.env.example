# Manual deployment. For the Docker quick start, run npm run setup at the repo root.
# Use a PostgreSQL 15+ database and a role authorized to run the included migrations.
DATABASE_URL=postgres://kaddiya:replace-with-your-password@localhost:5432/kaddiya

# Browser-guided, bring-your-own-model setup.
KADDIYA_EDITION=self-hosted
BASE_URL=http://localhost:3000
PORT=3000

# Generate two separate secrets, each 64 hex characters:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the master key with your database backups. Losing it loses encrypted data.
KADDIYA_MASTER_KEY=
KADDIYA_SETUP_TOKEN=
# Alternatively, supply the master key through a mounted secret file:
# KADDIYA_MASTER_KEY_FILE=/run/secrets/kaddiya-master-key

# Enter ServiceNow credentials and model keys in the browser guide.
# Existing operator-seeded installations may still set SN_INSTANCE_URL,
# SN_CLIENT_ID, SN_CLIENT_SECRET, KADDIYA_ORG and ANTHROPIC_* variables.

# Optional release family used when ServiceNow does not expose its release.
SN_DOCS_RELEASE=
