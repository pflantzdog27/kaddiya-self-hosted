node_modules/
dist/
target/
vendor/servicenow-docs/
.env
.env.*
!.env.example
*.log
.DS_Store
# never commit instance credentials
now-sdk-auth*.json

# Published design canvases: ~2.4 MB each, the Claude Design editor plus fonts
# with the design/**/*.dc.html sources embedded verbatim inside them. Verified
# identical to the sources beside them, and regenerated whole on every publish.
# Keep the sources; see design/README.md.
design/**/kaddiya-*.html

# Agent worktrees (git worktrees, ~180 MB, recreated on demand)
.claude/worktrees/

# Build specifications and their handoff prompts: forward-looking plans and
# release boundaries that belong in the working copy, not in a public repo.
# The decisions a reviewer needs are in the ADRs and in the PR that made them.
docs/plans/

# Demo scripts name a live developer instance and its OAuth client ID;
# they stay local to the presenter's machine, not in the public repo.
docs/demo-*.md

# Generated demo artifacts: screenshots, the capabilities PDF, the rendered
# architecture document, and the card gallery's copies of app.js/style.css.
# Rebuilt by scripts/seed-demo.mjs + scripts/demo-cards.mjs +
# scripts/demo-capture.mjs + scripts/doc-to-pdf.mjs; see docs/local-demo.md.
output/

# Scratch: intermediate build material for slides and one-off documents.
tmp/
